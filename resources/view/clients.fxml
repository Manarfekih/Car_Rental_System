<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ClientManagementController"
            prefWidth="900" prefHeight="600">

    <!-- ▬▬▬ TOP HEADER ▬▬▬ -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="👤 Client Management System"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            </HBox>

            <!-- Status Label -->
            <Label fx:id="lblStatus" text="Loading clients from database..."
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 0 0 5 0;" />
        </VBox>
    </top>


    <!-- ▬▬▬ CENTER CONTENT ▬▬▬ -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search:" />
                <TextField fx:id="searchField"
                           promptText="Search by name, email or license..."
                           HBox.hgrow="ALWAYS" />

                <Button fx:id="btnSearch" text="Search"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Button fx:id="btnRefresh" text="Refresh"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
                        
                        
                         <Label text="📈 Sort By:" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="sortCombo" promptText="Sort By"  style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>


            <!-- Table -->
            <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colName" text="Name" prefWidth="150" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180" />
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="130" />
                    <TableColumn fx:id="colLicense" text="License" prefWidth="130" />
                    <TableColumn fx:id="colAddress" text="Address" prefWidth="200" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>


            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnAdd" text="Add Client"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />

                <Button fx:id="btnEdit" text="Edit Client"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />

                <Button fx:id="btnDelete" text="Delete Client"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
            </HBox>

        </VBox>
    </center>


    <!-- ▬▬▬ FOOTER ▬▬▬ -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 8;">
            <Label text="Car Rental System - Client Management | © 2025"
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
        </HBox>
    </bottom>

</BorderPane>
