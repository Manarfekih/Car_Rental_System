<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RentalManagementController"
            prefWidth="900" prefHeight="600">
    
    <!-- Top Header -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📋 Rental Management" 
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            </HBox>
            <Label fx:id="lblStatus" text="Loading rentals..." 
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 0 0 5 0;" />
        </VBox>
    </top>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">
            
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search:" />
                <TextField fx:id="searchField" promptText="Search client, car or status..." 
                          HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSearch" text="Search" 
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
                <Button fx:id="btnRefresh" text="Refresh" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>
            
            <!-- Rentals Table -->
            <TableView fx:id="rentalsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colClient" text="Client" prefWidth="150" />
                    <TableColumn fx:id="colCar" text="Car" prefWidth="150" />
                    <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="120" />
                    <TableColumn fx:id="colEndDate" text="End Date" prefWidth="120" />
                    <TableColumn fx:id="colTotalPrice" text="Price" prefWidth="100" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            
            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnAdd" text="Add Rental" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                <Button fx:id="btnEdit" text="Edit Rental"  
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                <Button fx:id="btnDelete" text="Delete Rental" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                <Button fx:id="btnReturn" text="Return Car"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                        
                         <Label text="📈 Sort By"/>
    <ComboBox fx:id="sortComboBox" promptText="Select criteria"/>
    <Button text="Sort" fx:id="btnSort" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 8;">
            <Label text="Car Rental System - Rental Management | © 2025" 
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
        </HBox>
    </bottom>
    
</BorderPane>