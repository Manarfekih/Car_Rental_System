<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RegisterController"
      spacing="10"
      alignment="CENTER"
      prefWidth="400" prefHeight="550"
      style="-fx-padding: 20; -fx-background-color: #f0f0f0;">

    <!-- Title -->
    <Label fx:id="messageLabel"
           text="Register Form"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- User info -->
    <TextField fx:id="usernameField" promptText="Username" prefWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="250"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="250"/>
    <TextField fx:id="emailField" promptText="Email" prefWidth="250"/>

    <!-- Client info -->
    <TextField fx:id="nameField" promptText="Full Name" prefWidth="250"/>
    <TextField fx:id="phoneField" promptText="Phone (optional)" prefWidth="250"/>
    <TextField fx:id="licenseField" promptText="License Number" prefWidth="250"/>
    <TextField fx:id="addressField" promptText="Address" prefWidth="250"/>

    <!-- Register button -->
    <Button fx:id="registerButton" text="Register" prefWidth="150"/>

    <!-- Login link (text fixed only) -->
    <Button fx:id="loginLink"
            text="Already have an account? Sign In"
            style="-fx-background-color: transparent; -fx-underline: true; -fx-text-fill: blue;"
            />
</VBox>
