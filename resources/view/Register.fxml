<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.RegisterController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="30" right="40" bottom="20" left="40"/>
    </padding>

    <!-- Title -->
    <VBox spacing="5" alignment="CENTER">
        <Label text="🚗 Car Rental System"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        <Label text="Create New Account"
               style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;" />
    </VBox>

    <!-- Registration Form Card with ScrollPane -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 20px; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-min-width: 380;">
        
        <!-- Message Label -->
        <Label fx:id="messageLabel"
               wrapText="true"
               maxWidth="350"
               style="-fx-text-alignment: center; -fx-text-fill: #e74c3c; -fx-font-size: 14px;" />

        <!-- ScrollPane for fields -->
        <ScrollPane fitToWidth="true" 
                   style="-fx-background-color: transparent; -fx-padding: 0;"
                   vbarPolicy="AS_NEEDED"
                   hbarPolicy="NEVER"
                   prefViewportHeight="350">
            <VBox spacing="15" alignment="CENTER_LEFT" style="-fx-min-width: 320; -fx-padding: 10px;">
                
                <!-- Account Credentials -->
                <Label text="Account Information" 
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 16px; -fx-padding: 0 0 5 0; -fx-underline: true;" />
                
                <VBox spacing="5">
                    <Label text="Username *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="usernameField" 
                              promptText="Enter username"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Password *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <PasswordField fx:id="passwordField" 
                                  promptText="Enter password"
                                  style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Confirm Password *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <PasswordField fx:id="confirmPasswordField" 
                                  promptText="Confirm password"
                                  style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="emailField" 
                              promptText="Enter email"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>

                <Separator style="-fx-padding: 10px 0;" />

                <!-- Personal Information -->
                <Label text="Personal Information" 
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 16px; -fx-padding: 0 0 5 0; -fx-underline: true;" />
                
                <VBox spacing="5">
                    <Label text="Full Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="nameField" 
                              promptText="Enter full name"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Phone (Optional)" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="phoneField" 
                              promptText="Enter phone number"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="License Number *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="licenseField" 
                              promptText="Driver's license number"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
                <VBox spacing="5">
                    <Label text="Address *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <TextField fx:id="addressField" 
                              promptText="Enter address"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                </VBox>
                
            </VBox>
        </ScrollPane>

        <!-- Register Button -->
        <Button fx:id="registerButton"
                text="Register"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 40px; -fx-background-radius: 5; -fx-cursor: hand;" />

        <!-- Separator -->
        <Separator style="-fx-padding: 10px 0;" />

        <!-- Login Link -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="Already have an account?" style="-fx-text-fill: #7f8c8d;" />
            <Button fx:id="loginLink"
                    text="Sign In"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8px 30px; -fx-background-radius: 5; -fx-cursor: hand;" />
        </VBox>
    </VBox>

    <!-- Footer -->
    <Label text="© 2025 Car Rental System"
           style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;" />

</VBox>