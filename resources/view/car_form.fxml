<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CarFormController"
      spacing="15" 
      alignment="CENTER_LEFT" 
      style="-fx-padding: 20;"
      prefWidth="500" 
      prefHeight="450">

    <Label fx:id="titleLabel" text="Add Car"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Car Brand -->
    <HBox spacing="10">
        <Label text="Brand:" prefWidth="120"/>
        <TextField fx:id="brandField" promptText="Enter car brand" prefWidth="250"/>
    </HBox>

    <!-- Car Model -->
    <HBox spacing="10">
        <Label text="Model:" prefWidth="120"/>
        <TextField fx:id="modelField" promptText="Enter car model" prefWidth="250"/>
    </HBox>

    <!-- Year -->
    <HBox spacing="10">
        <Label text="Year:" prefWidth="120"/>
        <TextField fx:id="yearField" promptText="Enter year" prefWidth="250"/>
    </HBox>

    <!-- Category -->
    <HBox spacing="10">
        <Label text="Category:" prefWidth="120"/>
        <TextField fx:id="categoryField" promptText="Enter category" prefWidth="250"/>
    </HBox>

    <!-- Price per Day -->
    <HBox spacing="10">
        <Label text="Price/Day:" prefWidth="120"/>
        <TextField fx:id="priceField" promptText="Enter price per day" prefWidth="250"/>
    </HBox>

    <!-- Status -->
    <HBox spacing="10">
        <Label text="Status:" prefWidth="120"/>
        <ComboBox fx:id="statusCombo" prefWidth="250"/>
    </HBox>

    <!-- Status Label for errors -->
    <Label fx:id="statusLabel" style="-fx-text-fill: red;"/>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="saveBtn" text="Save" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
        <Button fx:id="cancelBtn" text="Cancel" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
    </HBox>

</VBox>