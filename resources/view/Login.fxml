<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      spacing="20"
      alignment="CENTER"
      style="-fx-background-color: #f5f5f5;">

    <!-- Padding -->
    <padding>
        <Insets top="40" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Title -->
    <VBox spacing="5" alignment="CENTER">
        <Label text="🚗 Car Rental System"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        <Label text="User Login"
               style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;" />
    </VBox>

    <!-- Login Form Card -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 30px; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        
        <!-- Input Fields -->
        <VBox spacing="15" alignment="CENTER_LEFT" style="-fx-min-width: 300;">
            <!-- Username -->
            <VBox spacing="5">
                <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <TextField fx:id="usernameField" 
                          promptText="Enter your username"
                          style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
            </VBox>
            
            <!-- Password -->
            <VBox spacing="5">
                <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <PasswordField fx:id="passwordField" 
                              promptText="Enter your password"
                              style="-fx-padding: 8px; -fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #ddd; -fx-border-radius: 5;" />
            </VBox>
        </VBox>

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="Login"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 40px; -fx-background-radius: 5; -fx-cursor: hand;" />

        <!-- Message Label -->
        <Label fx:id="messageLabel"
               wrapText="true"
               maxWidth="300"
               style="-fx-text-alignment: center; -fx-text-fill: #e74c3c;" />

        <!-- Separator -->
        <Separator style="-fx-padding: 10px 0;" />

        <!-- Register Section -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="Don't have an account?" style="-fx-text-fill: #7f8c8d;" />
            <Button fx:id="registerLink"
                    text="Create New Account"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8px 30px; -fx-background-radius: 5; -fx-cursor: hand;" />
        </VBox>
    </VBox>

    <!-- Footer -->
    <Label text="© 2025 Car Rental System"
           style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;" />

</VBox>