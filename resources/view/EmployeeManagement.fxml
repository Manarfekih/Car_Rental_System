<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.EmployeeManagementController"
            prefWidth="900" prefHeight="600">

    <!-- ▬▬▬ TOP HEADER ▬▬▬ -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="👔 Employee Management System"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            </HBox>

            <Label fx:id="lblStatus" text="Loading employees..."
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
        </VBox>
    </top>

    <!-- ▬▬▬ CENTER ▬▬▬ -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search:" />
                <TextField fx:id="searchField"
                           promptText="Search by username or email..."
                           HBox.hgrow="ALWAYS" />

                <Button fx:id="btnSearch" text="Search"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Button fx:id="btnRefresh" text="Refresh"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colPassword" text="Password" prefWidth="200"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Buttons -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnAdd" text="Add Employee"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />

                <Button fx:id="btnEdit" text="Edit Employee"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />

                <Button fx:id="btnDelete" text="Delete Employee"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
            </HBox>

        </VBox>
    </center>

    <!-- ▬▬▬ FOOTER ▬▬▬ -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 8;">
            <Label text="Car Rental System - Employee Management | © 2025"
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
        </HBox>
    </bottom>

</BorderPane>
