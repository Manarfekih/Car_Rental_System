<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ClientFormController"
      spacing="10" 
      alignment="CENTER_LEFT" 
      style="-fx-padding: 20;"
      prefWidth="500" prefHeight="350">

    <Label fx:id="titleLabel" text="Add / Edit Client" 
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints minWidth="320"/>
        </columnConstraints>

        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                   prefWidth="250"/>
        
        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" 
                   prefWidth="250"/>
        
        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                   prefWidth="250"/>
        
        <Label text="Driver License:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="licenseField" GridPane.rowIndex="3" GridPane.columnIndex="1" 
                   prefWidth="250"/>
        
        <Label text="Address:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="addressField" GridPane.rowIndex="4" GridPane.columnIndex="1" 
                   prefWidth="250"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="saveBtn" text="Save" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
        <Button fx:id="cancelBtn" text="Cancel" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill: red; -fx-padding: 0 0 0 20;"/>
    </HBox>

</VBox>