<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.EmployeeDashboardController"
            prefWidth="1000" prefHeight="700">

    <!-- Sidebar -->
    <left>
        <VBox spacing="15" style="-fx-background-color: #2D1E4F; -fx-padding: 20;" 
              fx:id="sidebar">
            <Label text="Employee Dashboard" 
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            
            <Separator style="-fx-background-color: #7f8c8d;"/>
            
            <Label fx:id="lblWelcome"  
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
            
            <Separator style="-fx-background-color: #7f8c8d;"/>
            
            <Label text="MANAGEMENT" style="-fx-text-fill: #bdc3c7; -fx-font-weight: bold;"/>
            <Button fx:id="btnCars" text="🚗 Cars" maxWidth="200"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>
            <Button fx:id="btnClients" text="👥 Clients" maxWidth="200"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>
            <Button fx:id="btnRentals" text="📋 Rentals" maxWidth="200"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>
           
            
            
            <VBox VBox.vgrow="ALWAYS"/>
            
            <!-- Back Button (initially hidden) -->
            <Button fx:id="btnBack" text="↩ Back to Dashboard" maxWidth="200" visible="false"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>
            
            <Button fx:id="btnLogout" text="🚪 Logout" maxWidth="200"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>
        </VBox>
    </left>

    <!-- Main content area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;">
            <!-- Default content will be loaded here -->
        </StackPane>
    </center>

</BorderPane>