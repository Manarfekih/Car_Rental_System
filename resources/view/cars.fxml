<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controller.CarManagementController"
            prefWidth="900" prefHeight="600">
    
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🚗 Car Management System" 
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
            </HBox>
            
            <!-- Status Label -->
            <Label fx:id="lblStatus" text="Loading cars from database..." 
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 0 0 5 0;" />
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search:" />
                <TextField fx:id="txtSearch" promptText="Search by brand, model, category or ID..." 
                          HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSearch" text="Search" onAction="#handleSearch" 
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
                <Button fx:id="btnRefresh" text="Refresh" onAction="#handleRefresh" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>
            
            <!-- Car Table -->
            <TableView fx:id="carTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCarId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colBrand" text="Brand" prefWidth="100" />
                    <TableColumn fx:id="colModel" text="Model" prefWidth="120" />
                    <TableColumn fx:id="colYear" text="Year" prefWidth="70" />
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="90" />
                    <TableColumn fx:id="colPrice" text="Price/Day" prefWidth="90" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            
            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnAdd" text="Add Car" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                <Button fx:id="btnUpdate" text="Update Car"  
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
                <Button fx:id="btnDelete" text="Delete Car" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" />
            </HBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 8;">
            <Label text="Car Rental System - Car Management | © 2025" 
                   style="-fx-text-fill: white; -fx-font-size: 12px;" />
        </HBox>
    </bottom>
</BorderPane>